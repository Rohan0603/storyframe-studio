{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyframe.local/schemas/episode-v1.json",
  "title": "StoryFrame Episode v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "episodeId",
    "mode",
    "script",
    "referenceBundle",
    "narration",
    "beats",
    "shots",
    "release"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "episodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "mode": {
      "enum": [
        "guided",
        "auto"
      ]
    },
    "script": {
      "$ref": "#/$defs/hashedPath"
    },
    "referenceBundle": {
      "$ref": "#/$defs/hashedPath"
    },
    "series": {
      "$ref": "#/$defs/seriesConfiguration"
    },
    "imagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "requireNativeReceipt",
        "requireVisualScreening"
      ],
      "properties": {
        "width": {
          "const": 1920
        },
        "height": {
          "const": 1080
        },
        "requireNativeReceipt": {
          "const": true
        },
        "requireVisualScreening": {
          "const": true
        }
      }
    },
    "referenceBible": {
      "$ref": "#/$defs/referenceBibleManifest"
    },
    "narration": {
      "type": "object",
      "required": [
        "provider",
        "textSha256",
        "audioPath",
        "alignmentPath",
        "alignmentVerified"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "textSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioPath": {
          "type": "string",
          "minLength": 1
        },
        "alignmentPath": {
          "type": "string",
          "minLength": 1
        },
        "alignmentVerified": {
          "type": "boolean"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "voiceName": {
          "type": "string",
          "minLength": 1
        },
        "audioSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioDurationMs": {
          "type": "integer",
          "minimum": 1
        },
        "receiptPath": {
          "type": "string",
          "minLength": 1
        },
        "captionsPath": {
          "type": "string",
          "minLength": 1
        },
        "alignmentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "story": {
      "$ref": "#/$defs/story"
    },
    "alignment": {
      "$ref": "#/$defs/alignment"
    },
    "syncTimeline": {
      "$ref": "#/$defs/syncTimeline"
    },
    "production": {
      "$ref": "#/$defs/production"
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "release": {
      "type": "object",
      "required": [
        "productionQAPassed",
        "creativeApproval",
        "publishAuthorization"
      ]
    }
  },
  "$defs": {
    "production": {
      "type": "object",
      "required": [
        "version",
        "runId",
        "policy",
        "approvals"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxShots",
            "maxDurationMs",
            "maxImageAttemptsPerShot",
            "maxCloudTtsRequests",
            "imageCallsAuthorized",
            "cloudTtsCallsAuthorized",
            "budgetUsd",
            "publishingAuthorized"
          ],
          "properties": {
            "maxShots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            },
            "maxDurationMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 3600000
            },
            "maxImageAttemptsPerShot": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxCloudTtsRequests": {
              "const": 0
            },
            "imageCallsAuthorized": {
              "const": false
            },
            "cloudTtsCallsAuthorized": {
              "const": false
            },
            "budgetUsd": {
              "const": 0
            },
            "publishingAuthorized": {
              "const": false
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "stage",
              "fingerprint",
              "reviewer",
              "notes",
              "recordedAt"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "research",
                  "script",
                  "beat-map",
                  "references",
                  "images",
                  "narration",
                  "captions",
                  "render",
                  "final-qa"
                ]
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "recordedAt": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "render": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "durationMs",
            "width",
            "height",
            "videoCodec",
            "audioCodec"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "durationMs": {
              "type": "integer",
              "minimum": 1
            },
            "width": {
              "const": 1920
            },
            "height": {
              "const": 1080
            },
            "videoCodec": {
              "const": "h264"
            },
            "audioCodec": {
              "const": "aac"
            }
          }
        },
        "review": {
          "type": "object",
          "required": [
            "reviewer",
            "notes",
            "renderSha256",
            "checks"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "renderSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "checks": {
              "type": "object",
              "required": [
                "audiovisual",
                "captionSync",
                "storyImageMatch",
                "rights",
                "originality",
                "claims",
                "aiDisclosure"
              ],
              "properties": {
                "audiovisual": {
                  "$ref": "#/$defs/qaFinding"
                },
                "captionSync": {
                  "$ref": "#/$defs/qaFinding"
                },
                "storyImageMatch": {
                  "$ref": "#/$defs/qaFinding"
                },
                "rights": {
                  "$ref": "#/$defs/qaFinding"
                },
                "originality": {
                  "$ref": "#/$defs/qaFinding"
                },
                "claims": {
                  "$ref": "#/$defs/qaFinding"
                },
                "aiDisclosure": {
                  "$ref": "#/$defs/qaFinding"
                }
              }
            }
          }
        },
        "youtube": {
          "type": "object",
          "required": [
            "title",
            "description",
            "disclosure",
            "tags",
            "chapters"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "disclosure": {
              "type": "string",
              "minLength": 1
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "chapters": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "startMs",
                  "title"
                ],
                "properties": {
                  "startMs": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "qaFinding": {
      "type": "object",
      "required": [
        "status",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hashedPath": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "story": {
      "type": "object",
      "required": [
        "scriptRevision",
        "sourceClaims",
        "canon",
        "beatCandidates"
      ],
      "properties": {
        "scriptRevision": {
          "type": "object",
          "required": [
            "id",
            "text",
            "textSha256",
            "segments"
          ]
        },
        "narrativePlan": {
          "type": "object",
          "required": [
            "hook",
            "contradiction",
            "protagonistGoal",
            "stakes",
            "escalationBeats",
            "reversal",
            "endingPayoff",
            "voiceDirection",
            "factualGuardrails"
          ],
          "properties": {
            "hook": {
              "type": "string",
              "minLength": 1
            },
            "contradiction": {
              "type": "string",
              "minLength": 1
            },
            "protagonistGoal": {
              "type": "string",
              "minLength": 1
            },
            "stakes": {
              "type": "string",
              "minLength": 1
            },
            "escalationBeats": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "reversal": {
              "type": "string",
              "minLength": 1
            },
            "endingPayoff": {
              "type": "string",
              "minLength": 1
            },
            "voiceDirection": {
              "type": "string",
              "minLength": 1
            },
            "factualGuardrails": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sourceClaims": {
          "type": "array"
        },
        "canon": {
          "type": "object",
          "required": [
            "characters",
            "props",
            "observations"
          ]
        },
        "beatCandidates": {
          "type": "array"
        }
      }
    },
    "alignment": {
      "type": "object",
      "required": [
        "scriptRevisionId",
        "scriptSha256",
        "timingStatus",
        "audioDurationMs",
        "density"
      ],
      "properties": {
        "scriptRevisionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "scriptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scriptRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timingStatus": {
          "enum": [
            "provisional",
            "verified"
          ]
        },
        "audioDurationMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "density": {
          "type": "object",
          "required": [
            "style",
            "targetMin",
            "targetMax"
          ],
          "properties": {
            "style": {
              "enum": [
                "reflective",
                "cinematic",
                "energetic",
                "custom"
              ]
            },
            "targetMin": {
              "type": "number",
              "minimum": 0
            },
            "targetMax": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "id",
        "spokenText",
        "scriptStartChar",
        "scriptEndChar",
        "sourceClaimIds",
        "scriptRevisionId",
        "scriptRevisionSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "spokenText": {
          "type": "string"
        },
        "scriptStartChar": {
          "type": "integer",
          "minimum": 0
        },
        "scriptEndChar": {
          "type": "integer",
          "minimum": 0
        },
        "sourceClaimIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scriptRevisionId": {
          "type": "string"
        },
        "scriptRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "beatIds",
        "audioStartMs",
        "audioEndMs",
        "requiredVisualEvent",
        "characters",
        "props",
        "environment",
        "composition",
        "forbidden",
        "visualPurpose",
        "image",
        "semanticReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "sceneId": {
          "type": "string",
          "minLength": 1
        },
        "beatIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "audioStartMs": {
          "type": "integer",
          "minimum": 0
        },
        "audioEndMs": {
          "type": "integer",
          "minimum": 1
        },
        "requiredVisualEvent": {
          "type": "string",
          "minLength": 1
        },
        "imagePrompt": {
          "type": "string",
          "minLength": 1
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visualPurpose": {
          "enum": [
            "action",
            "establishing",
            "transition",
            "hold"
          ]
        },
        "intentionalHold": {
          "type": "object",
          "required": [
            "reason",
            "relatedBeatIds"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "relatedBeatIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          }
        },
        "referenceBinding": {
          "$ref": "#/$defs/referenceBinding"
        },
        "seriesBinding": {
          "$ref": "#/$defs/seriesBinding"
        },
        "image": {
          "$ref": "#/$defs/imageOutput"
        },
        "semanticReview": {
          "$ref": "#/$defs/semanticReview"
        }
      }
    },
    "imageOutput": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "needs-review",
            "approved",
            "rejected",
            "blocked",
            "failed",
            "stale"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/imageProvenance"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sha256": {
                "type": "string"
              }
            }
          },
          "then": {
            "required": [
              "provenance"
            ]
          }
        }
      ]
    },
    "imageProvenance": {
      "type": "object",
      "required": [
        "tool",
        "packetSha256",
        "attemptId",
        "receiptStatus",
        "width",
        "height"
      ],
      "properties": {
        "tool": {
          "const": "codex-desktop.image_gen"
        },
        "packetSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "attemptId": {
          "type": "string",
          "minLength": 1
        },
        "nativeReceiptId": {
          "type": "string",
          "minLength": 1
        },
        "nativeImage": {
          "type": "object",
          "required": [
            "path",
            "sha256",
            "width",
            "height"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "receiptStatus": {
          "enum": [
            "persisted",
            "reconciled"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "journalPath": {
          "type": "string",
          "minLength": 1
        },
        "journalEntrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "providerEvidence": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "normalizationReceipt": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "semanticReview": {
      "type": "object",
      "required": [
        "status",
        "reviewedImageSha256",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail",
            "unknown"
          ]
        },
        "reviewedImageSha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "pixelsDecoded": {
          "type": "boolean"
        },
        "screening": {
          "type": "object",
          "required": [
            "imageSha256",
            "collage",
            "text",
            "checkedBy",
            "notes"
          ],
          "properties": {
            "imageSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "collage": {
              "enum": [
                "clear",
                "suspected",
                "unknown"
              ]
            },
            "text": {
              "enum": [
                "clear",
                "detected",
                "unknown"
              ]
            },
            "checkedBy": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "string",
              "minLength": 1
            },
            "evidencePath": {
              "type": "string",
              "minLength": 1
            },
            "evidenceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "allowedText": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reviewedPacketSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "required": [
              "pixelsDecoded"
            ],
            "properties": {
              "pixelsDecoded": {
                "const": true
              },
              "reviewedImageSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "referenceImage": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "mimeType",
        "approved"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ]
        },
        "approved": {
          "type": "boolean"
        }
      }
    },
    "referenceEntry": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "visualCanon",
        "image"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "prop",
            "environment",
            "style"
          ]
        },
        "name": {
          "type": "string"
        },
        "visualCanon": {
          "type": "string"
        },
        "canonEntityId": {
          "type": "string"
        },
        "image": {
          "$ref": "#/$defs/referenceImage"
        }
      }
    },
    "referenceBible": {
      "type": "object",
      "required": [
        "bundleId",
        "storyRevisionId",
        "storyRevisionSha256",
        "canonSha256",
        "entries"
      ],
      "properties": {
        "bundleId": {
          "type": "string"
        },
        "storyRevisionId": {
          "type": "string"
        },
        "storyRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/referenceEntry"
          }
        }
      }
    },
    "referenceBibleManifest": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "freezeSha256",
        "storyRevisionId",
        "storyRevisionSha256",
        "canonSha256",
        "status"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "freezeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storyRevisionId": {
          "type": "string"
        },
        "storyRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "enum": [
            "draft",
            "frozen",
            "stale"
          ]
        }
      }
    },
    "referenceBinding": {
      "type": "object",
      "required": [
        "freezeSha256",
        "storyRevisionId",
        "referenceIds",
        "referenceHashes"
      ],
      "properties": {
        "freezeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "storyRevisionId": {
          "type": "string"
        },
        "referenceIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "referenceHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "seriesConfiguration": {
      "type": "object",
      "required": [
        "seriesId",
        "revisionId",
        "biblePath",
        "bibleSha256",
        "visualFormat",
        "applied"
      ],
      "properties": {
        "seriesId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "revisionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "biblePath": {
          "type": "string",
          "minLength": 1
        },
        "bibleSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "visualFormat": {
          "enum": [
            "2d-still",
            "3d-still"
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "evolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "episodeOrder"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "episodeOrder": {
              "type": "integer",
              "minimum": 1
            },
            "predecessor": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "manifestPath",
                "manifestSha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "manifestPath": {
                  "type": "string",
                  "minLength": 1
                },
                "manifestSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "legacyMigrationNotes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "seriesBinding": {
      "type": "object",
      "required": [
        "seriesId",
        "revisionId"
      ],
      "properties": {
        "seriesId": {
          "type": "string",
          "minLength": 1
        },
        "revisionId": {
          "type": "string",
          "minLength": 1
        },
        "entityStates": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "syncSubtitle": {
      "type": "object",
      "required": [
        "cueId",
        "startMs",
        "endMs",
        "text",
        "alignmentStatus"
      ],
      "properties": {
        "cueId": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "alignmentStatus": {
          "enum": [
            "verified",
            "provisional",
            "unknown"
          ]
        },
        "sourceWordStart": {
          "type": "integer",
          "minimum": 0
        },
        "sourceWordEnd": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "syncRecord": {
      "type": "object",
      "required": [
        "shotId",
        "sceneId",
        "startMs",
        "endMs",
        "narration",
        "image",
        "subtitles"
      ],
      "properties": {
        "shotId": {
          "type": "string",
          "minLength": 1
        },
        "sceneId": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 1
        },
        "narration": {
          "type": "object"
        },
        "image": {
          "type": "object"
        },
        "subtitles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncSubtitle"
          }
        }
      }
    },
    "syncTimeline": {
      "type": "object",
      "required": [
        "version",
        "status",
        "audioSha256",
        "audioDurationMs",
        "scriptSha256",
        "alignmentPath",
        "records"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "enum": [
            "verified",
            "legacy-unverified"
          ]
        },
        "audioSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audioDurationMs": {
          "type": "integer",
          "minimum": 1
        },
        "scriptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "alignmentPath": {
          "type": "string",
          "minLength": 1
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syncRecord"
          }
        }
      }
    }
  }
}
