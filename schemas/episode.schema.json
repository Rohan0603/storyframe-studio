{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyframe.local/schemas/episode-v1.json",
  "title": "StoryFrame Episode v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "episodeId",
    "mode",
    "script",
    "referenceBundle",
    "narration",
    "beats",
    "shots",
    "release"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "episodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "mode": { "enum": ["guided", "auto"] },
    "script": { "$ref": "#/$defs/hashedPath" },
    "referenceBundle": { "$ref": "#/$defs/hashedPath" },
    "referenceBible": { "$ref": "#/$defs/referenceBibleManifest" },
    "narration": {
      "type": "object",
      "required": [
        "provider",
        "textSha256",
        "audioPath",
        "alignmentPath",
        "alignmentVerified"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "textSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "audioPath": { "type": "string", "minLength": 1 },
        "alignmentPath": { "type": "string", "minLength": 1 },
        "alignmentVerified": { "type": "boolean" },
        "model": { "type": "string", "minLength": 1 },
        "voiceName": { "type": "string", "minLength": 1 },
        "audioSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "audioDurationMs": { "type": "integer", "minimum": 1 },
        "receiptPath": { "type": "string", "minLength": 1 },
        "captionsPath": { "type": "string", "minLength": 1 }
      }
    },
    "story": { "$ref": "#/$defs/story" },
    "alignment": { "$ref": "#/$defs/alignment" },
    "beats": { "type": "array", "items": { "$ref": "#/$defs/beat" } },
    "shots": { "type": "array", "items": { "$ref": "#/$defs/shot" } },
    "release": {
      "type": "object",
      "required": [
        "productionQAPassed",
        "creativeApproval",
        "publishAuthorization"
      ]
    }
  },
  "$defs": {
    "hashedPath": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "story": {
      "type": "object",
      "required": ["scriptRevision", "sourceClaims", "canon", "beatCandidates"],
      "properties": {
        "scriptRevision": {
          "type": "object",
          "required": ["id", "text", "textSha256", "segments"]
        },
        "sourceClaims": { "type": "array" },
        "canon": {
          "type": "object",
          "required": ["characters", "props", "observations"]
        },
        "beatCandidates": { "type": "array" }
      }
    },
    "alignment": {
      "type": "object",
      "required": [
        "scriptRevisionId",
        "scriptSha256",
        "timingStatus",
        "audioDurationMs",
        "density"
      ],
      "properties": {
        "scriptRevisionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "scriptSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "scriptRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "timingStatus": { "enum": ["provisional", "verified"] },
        "audioDurationMs": { "type": ["integer", "null"], "minimum": 1 },
        "density": {
          "type": "object",
          "required": ["style", "targetMin", "targetMax"],
          "properties": {
            "style": {
              "enum": ["reflective", "cinematic", "energetic", "custom"]
            },
            "targetMin": { "type": "number", "minimum": 0 },
            "targetMax": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "id",
        "spokenText",
        "scriptStartChar",
        "scriptEndChar",
        "sourceClaimIds",
        "scriptRevisionId",
        "scriptRevisionSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "spokenText": { "type": "string" },
        "scriptStartChar": { "type": "integer", "minimum": 0 },
        "scriptEndChar": { "type": "integer", "minimum": 0 },
        "sourceClaimIds": { "type": "array", "items": { "type": "string" } },
        "scriptRevisionId": { "type": "string" },
        "scriptRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "shot": {
      "type": "object",
      "required": [
        "id",
        "beatIds",
        "audioStartMs",
        "audioEndMs",
        "requiredVisualEvent",
        "characters",
        "props",
        "environment",
        "composition",
        "forbidden",
        "visualPurpose",
        "image",
        "semanticReview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "beatIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "audioStartMs": { "type": "integer", "minimum": 0 },
        "audioEndMs": { "type": "integer", "minimum": 1 },
        "requiredVisualEvent": { "type": "string", "minLength": 1 },
        "characters": { "type": "array", "items": { "type": "string" } },
        "props": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "string", "minLength": 1 },
        "composition": { "type": "string", "minLength": 1 },
        "forbidden": { "type": "array", "items": { "type": "string" } },
        "visualPurpose": {
          "enum": ["action", "establishing", "transition", "hold"]
        },
        "intentionalHold": {
          "type": "object",
          "required": ["reason", "relatedBeatIds"],
          "properties": {
            "reason": { "type": "string", "minLength": 1 },
            "relatedBeatIds": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            }
          }
        },
        "referenceBinding": { "$ref": "#/$defs/referenceBinding" },
        "image": { "$ref": "#/$defs/imageOutput" },
        "semanticReview": { "$ref": "#/$defs/semanticReview" }
      }
    },
    "imageOutput": {
      "type": "object",
      "required": ["path", "sha256", "status"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "status": {
          "enum": [
            "pending",
            "ready",
            "running",
            "needs-review",
            "approved",
            "rejected",
            "blocked",
            "failed",
            "stale"
          ]
        },
        "provenance": { "$ref": "#/$defs/imageProvenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "sha256": { "type": "string" } } },
          "then": { "required": ["provenance"] }
        }
      ]
    },
    "imageProvenance": {
      "type": "object",
      "required": [
        "tool",
        "packetSha256",
        "attemptId",
        "receiptStatus",
        "width",
        "height"
      ],
      "properties": {
        "tool": { "const": "codex-desktop.image_gen" },
        "packetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "attemptId": { "type": "string", "minLength": 1 },
        "receiptStatus": { "enum": ["persisted", "reconciled"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "semanticReview": {
      "type": "object",
      "required": ["status", "reviewedImageSha256", "notes"],
      "properties": {
        "status": { "enum": ["pending", "pass", "fail", "unknown"] },
        "reviewedImageSha256": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "pixelsDecoded": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } } },
          "then": {
            "required": ["pixelsDecoded"],
            "properties": {
              "pixelsDecoded": { "const": true },
              "reviewedImageSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "referenceImage": {
      "type": "object",
      "required": ["path", "sha256", "mimeType", "approved"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mimeType": {
          "enum": ["image/png", "image/jpeg", "image/gif", "image/webp"]
        },
        "approved": { "type": "boolean" }
      }
    },
    "referenceEntry": {
      "type": "object",
      "required": ["id", "kind", "name", "visualCanon", "image"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["character", "prop", "environment", "style"] },
        "name": { "type": "string" },
        "visualCanon": { "type": "string" },
        "canonEntityId": { "type": "string" },
        "image": { "$ref": "#/$defs/referenceImage" }
      }
    },
    "referenceBible": {
      "type": "object",
      "required": [
        "bundleId",
        "storyRevisionId",
        "storyRevisionSha256",
        "canonSha256",
        "entries"
      ],
      "properties": {
        "bundleId": { "type": "string" },
        "storyRevisionId": { "type": "string" },
        "storyRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/referenceEntry" }
        }
      }
    },
    "referenceBibleManifest": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "freezeSha256",
        "storyRevisionId",
        "storyRevisionSha256",
        "canonSha256",
        "status"
      ],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "freezeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "storyRevisionId": { "type": "string" },
        "storyRevisionSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "canonSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "status": { "enum": ["draft", "frozen", "stale"] }
      }
    },
    "referenceBinding": {
      "type": "object",
      "required": [
        "freezeSha256",
        "storyRevisionId",
        "referenceIds",
        "referenceHashes"
      ],
      "properties": {
        "freezeSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "storyRevisionId": { "type": "string" },
        "referenceIds": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "referenceHashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
