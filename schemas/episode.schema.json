{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyframe.local/schemas/episode-v1.json",
  "title": "StoryFrame Episode v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "episodeId",
    "mode",
    "script",
    "referenceBundle",
    "narration",
    "beats",
    "shots",
    "release"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "episodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "mode": { "enum": ["guided", "auto"] },
    "script": { "$ref": "#/$defs/hashedPath" },
    "referenceBundle": { "$ref": "#/$defs/hashedPath" },
    "narration": {
      "type": "object",
      "required": [
        "provider",
        "textSha256",
        "audioPath",
        "alignmentPath",
        "alignmentVerified"
      ]
    },
    "story": { "$ref": "#/$defs/story" },
    "beats": { "type": "array" },
    "shots": { "type": "array" },
    "release": {
      "type": "object",
      "required": [
        "productionQAPassed",
        "creativeApproval",
        "publishAuthorization"
      ]
    }
  },
  "$defs": {
    "hashedPath": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "story": {
      "type": "object",
      "required": ["scriptRevision", "sourceClaims", "canon", "beatCandidates"],
      "properties": {
        "scriptRevision": {
          "type": "object",
          "required": ["id", "text", "textSha256", "segments"]
        },
        "sourceClaims": { "type": "array" },
        "canon": {
          "type": "object",
          "required": ["characters", "props", "observations"]
        },
        "beatCandidates": { "type": "array" }
      }
    }
  }
}
